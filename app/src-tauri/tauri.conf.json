{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MISAKA Model Transport",
  "version": "0.1.0",
  "identifier": "com.misaka.model-transport",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MISAKA Model Transport",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Download and seed MISAKA models over BitTorrent v2",
    "longDescription": "MISAKA Model Transport downloads AI models listed on misakaoptions.com over BitTorrent v2, checks every byte, and seeds them back while it runs. Transport only: it knows no chain, holds no key and executes nothing it receives.",
    "copyright": "Apache-2.0",
    "license": "Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/misaka-torrentd"],
    "resources": { "../../deploy/launchd/misaka-torrentd.sb": "misaka-torrentd.sb" },
    "macOS": { "minimumSystemVersion": "12.0" },
    "linux": { "deb": { "depends": ["libssl3t64 | libssl3"], "desktopTemplate": "linux.desktop.hbs" } }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["misaka-model"] }
    }
  }
}
