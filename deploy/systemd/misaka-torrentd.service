# misaka-torrentd, server profile (RFC-0001 §6.5). A starting unit, adapted from misakas's OTA
# fetcher sandbox; drill D-T9 confirms it on a real host.
#
# - A dedicated account, never kaspad's: kaspad holds hot keys in-process.
# - kaspad reads the store through the misaka_models group and never writes it.
# - The daemon does not seed unless /etc/misaka/torrent.toml sets [seeding] enabled = true (MT-12).

[Unit]
Description=MISAKA Torrent daemon (transport only: no chain, no keys, no execution)
Documentation=https://github.com/MISAKA-BTC/misaka-model-transport/blob/main/docs/rfc/0001-misaka-torrent.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=misaka_torrent
Group=misaka_models
ExecStart=/usr/local/bin/misaka-torrentd run --profile server
Restart=on-failure
RestartSec=5

StateDirectory=misaka-torrent
StateDirectoryMode=0750
RuntimeDirectory=misaka-torrent
RuntimeDirectoryMode=0750
ConfigurationDirectory=misaka

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The daemon confines itself (Landlock + its own seccomp filter) before the engine starts; older
# systemd groups do not list these, and a filter would kill the process at its first call.
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self seccomp
SystemCallFilter=~@privileged @mount @module @reboot @swap @raw-io @debug @cpu-emulation @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/misaka-torrent /run/misaka-torrent
UMask=0027
MemoryMax=2G
CPUWeight=50
IOWeight=50

[Install]
WantedBy=multi-user.target
